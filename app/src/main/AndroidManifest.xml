<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio recording for speech recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Floating HUD window over ChatGPT -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground services for uninterrupted voice loop (Android 10 - 14 compatible) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Battery optimization exemption for Samsung One UI 2.5 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Haptic feedback for loop transitions -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Network for online speech models & TTS updates -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Samsung DeX & Freeform Window Feature Declarations -->
    <uses-feature android:name="android.software.freeform_window_management" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <queries>
        <package android:name="com.openai.chatgpt" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".VoiceLoopApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Samsung DeX Desktop & Multi-Display Support Metadata -->
        <meta-data android:name="com.sec.android.desktopmode.mode" android:value="true" />
        <meta-data android:name="com.sec.android.support.multiwindow" android:value="true" />
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <meta-data android:name="com.sec.android.multiwindow.activity.launchMode" android:value="freeform" />
            <layout
                android:defaultWidth="600dp"
                android:defaultHeight="800dp"
                android:minWidth="340dp"
                android:minHeight="420dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service to interact with ChatGPT -->
        <service
            android:name=".service.VoiceLoopAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground Service managing the voice loop and floating HUD (Android 10 - 14 clean) -->
        <service
            android:name=".service.VoiceLoopForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

    </application>

</manifest>
